# =============================================================================
# TrustMesh Environment Configuration
# =============================================================================
# Copy to .env (repo root) and fill in your keys.
# Model stack: Gemini 3.x (main) → RedPill TEE (sensitive) → Claude (fallback)

# =============================================================================
# PRIMARY — Google Gemini (main agent + voice)
# =============================================================================
# Powers: agent chat (gemini-3.1-pro-preview), fast queries (gemini-3-flash-preview),
# and voice (gemini-2.5-flash-native-audio)
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# =============================================================================
# SENSITIVE DATA — RedPill TEE (medical / financial)
# =============================================================================
# Encrypted inference for sensitive capsules — provider cannot see plaintext.
# Sign up at: https://redpill.ai
REDPILL_API_KEY=

# =============================================================================
# FALLBACK LLM — Anthropic Claude (used if no GOOGLE_API_KEY + test suite)
# =============================================================================
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxx

# =============================================================================
# WEB SEARCH — Optional (enables agent web_search tool)
# =============================================================================

# Tavily API key for real web search results
# Sign up: https://tavily.com — free tier: 1000 searches/month
TAVILY_API_KEY=tvly-xxx

# =============================================================================
# EMAIL — Optional (enables network invite flow)
# =============================================================================

# Resend API key for sending invite emails
# Sign up: https://resend.com — free tier: 3000 emails/month
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=TrustMesh <invites@trustmesh.app>

# =============================================================================
# TEE MODELS — Optional (Trusted Execution Environment for sensitive data)
# =============================================================================
# TEE models run inference inside secure enclaves — the provider cannot see
# your data. Use for medical records, financial data, private capsules.
# Both are OpenAI-compatible APIs.

# Tinfoil — https://tinfoil.sh
# Sign up and get API key from dashboard
TINFOIL_API_KEY=
TINFOIL_BASE_URL=https://api.tinfoil.sh/v1

# Redpill — https://redpill.ai
# Sign up and get API key from dashboard
REDPILL_API_KEY=
REDPILL_BASE_URL=https://api.redpill.ai/v1

# Which TEE provider to use as primary: "tinfoil" or "redpill"
TEE_PRIMARY_PROVIDER=redpill

# =============================================================================
# GOOGLE INTEGRATIONS — Optional (Calendar, Gmail, Contacts via MCP)
# =============================================================================
# Create a GCP project → enable Calendar API → create OAuth 2.0 client
# Guide: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# =============================================================================
# CITADEL SECURITY — Optional (prompt injection / content guard)
# =============================================================================
# URL of the Citadel OSS guard service (runs separately) or Pro for Multimodal protection
# See citadel-ref/ for setup

CITADEL_URL=http://localhost:3001
CITADEL_API_KEY=

# =============================================================================
# DATABASE — Optional (defaults to SQLite)
# =============================================================================

# SQLite path (default: ./trustmesh.db)
# DATABASE_URL=sqlite+aiosqlite:///./trustmesh.db

# For production, use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/trustmesh

# =============================================================================
# APPLICATION — Optional
# =============================================================================

# Demo password for seed users (default: TrustMesh-demo-2026)
# DEMO_PASSWORD=TrustMesh-demo-2026

# Frontend URL for CORS (default: http://localhost:3050)
# FRONTEND_URL=http://localhost:3050

# Server port (default: 8000)
# PORT=8000
