FROM oven/bun:1 AS builder

WORKDIR /app

COPY trustmesh-registry/package.json trustmesh-registry/bun.lock* ./
RUN bun install --frozen-lockfile

COPY trustmesh-registry/ .

RUN bun run build

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM oven/bun:1

WORKDIR /app

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/package.json .
COPY --from=builder /app/node_modules ./node_modules

# oven/bun ships with a 'bun' user (UID 1000). Drop to it for runtime.
RUN chown -R bun:bun /app

USER bun

EXPOSE 8080

CMD ["sh", "-c", "bun node_modules/.bin/next start --port ${PORT:-8080}"]
