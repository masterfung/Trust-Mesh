# Stage 1: Zig cross-compiler — runs NATIVELY on the build host (arm64 or x86_64).
# Cross-compiles libpodos.so to x86_64-linux-gnu. No QEMU needed here.
FROM --platform=$BUILDPLATFORM python:3.12-slim AS zig-builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Download the Zig binary for the native build architecture
ARG ZIG_VERSION=0.15.2
RUN ARCH=$(uname -m) && \
    case "$ARCH" in \
      aarch64) ZIG_ARCH=aarch64-linux ;; \
      x86_64)  ZIG_ARCH=x86_64-linux ;; \
      *) echo "Unsupported arch: $ARCH" && exit 1 ;; \
    esac && \
    curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-${ZIG_ARCH}-${ZIG_VERSION}.tar.xz" \
    | tar -xJ -C /opt && \
    ln -s "/opt/zig-${ZIG_ARCH}-${ZIG_VERSION}/zig" /usr/local/bin/zig && \
    zig version

# Only the kernel needs to be in the builder stage
COPY trustmesh-core/kernel/ ./kernel/

# Cross-compile to x86_64-linux-gnu — output: kernel/zig-out/lib/libpodos.so
RUN cd kernel && zig build -Dtarget=x86_64-linux-gnu -Doptimize=ReleaseSafe

# Stage 2: Litestream binary (pull from official image — avoids URL guessing)
FROM --platform=linux/amd64 litestream/litestream:0.3.13 AS litestream

# ── Stage 3: Runtime ─────────────────────────────────────────────────────────
# This stage runs as linux/amd64 (the target platform). Python deps are installed
# here so pip/uv download x86_64 wheels — NOT ARM64 wheels from the zig-builder.
FROM python:3.12-slim

WORKDIR /app

# sqlite3 CLI (used by start.sh for row count check)
# No libsqlite3-0 needed — sqlite3.c is statically compiled into libpodos.so
RUN apt-get update && apt-get install -y --no-install-recommends \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Copy Litestream binary from official image
COPY --from=litestream /usr/local/bin/litestream /usr/local/bin/litestream
RUN litestream version

# Install uv
RUN pip install --no-cache-dir uv

# pyproject.toml references ../README.md
COPY README.md /README.md

# Copy full backend source (Python + kernel sources, pyproject.toml, etc.)
COPY trustmesh-core/ .

# Install Python deps NATIVELY in x86_64 runtime — gets correct binary wheels
# (greenlet, aiosqlite, cryptography, etc. all get x86_64 wheels here)
RUN uv sync --no-dev

# Overwrite kernel/zig-out/ with the x86_64 binary from the zig-builder stage
COPY --from=zig-builder /app/kernel/zig-out/ ./kernel/zig-out/

# Startup script
COPY scripts/start.sh /scripts/start.sh
RUN chmod +x /scripts/start.sh

# Non-root runtime user
RUN groupadd -r trustmesh && useradd --no-log-init -r -g trustmesh -u 1000 trustmesh \
    && mkdir -p /data \
    && chown -R trustmesh:trustmesh /app /scripts /data

USER 1000:1000

EXPOSE 9000

# start.sh: restore from GCS → seed if empty → litestream replicate -exec uvicorn
# Falls back to plain uvicorn when LITESTREAM_GCS_BUCKET is unset (local/compose)
CMD ["/scripts/start.sh"]
