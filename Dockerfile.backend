FROM python:3.12-slim

WORKDIR /app

# System deps: SQLite dev headers (for Zig kernel build) + curl for Zig download
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsqlite3-dev \
    curl \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Zig 0.15.2 (matches development toolchain)
RUN curl -fsSL https://ziglang.org/download/0.15.2/zig-linux-x86_64-0.15.2.tar.xz \
    | tar -xJ -C /opt && \
    ln -s /opt/zig-linux-x86_64-0.15.2/zig /usr/local/bin/zig

# Install uv
RUN pip install uv

# Copy backend source (includes kernel/)
COPY trustmesh-core/ .

# Build libpodos.so (Zig kernel — FTS5, transit, timeline, crypto)
RUN cd kernel && zig build -Doptimize=ReleaseSafe

# Install Python dependencies
RUN uv sync --no-dev

# Expose port
EXPOSE 9000

# Seed DB at startup, then run the server
# Each cold start gets a fresh DB — correct for demo
CMD ["sh", "-c", \
    "uv run python -m src.seed && \
     uv run uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-9000}"]
